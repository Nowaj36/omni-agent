# Copy to .env.local for local development.
# The hackathon harness injects these at runtime — never bundle real values in the image.

# Provided by the harness — use this key, not your own. 
FIREWORKS_API_KEY=your-fireworks-api-key

# Base URL for all Fireworks API calls.
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Comma-separated list of permitted Fireworks model IDs, published on launch day.
ALLOWED_MODELS=accounts/fireworks/models/your-model-a,accounts/fireworks/models/your-model-b

# server = HTTP API, batch = read /input/tasks.json and write /output/results.json.
AGENT_MODE=server

# fireworks = Fireworks API, local = vLLM OpenAI-compatible server.
LLM_PROVIDER=fireworks

# Base URL of the local vLLM OpenAI-compatible API (used when LLM_PROVIDER=local).
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
